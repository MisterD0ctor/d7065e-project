# C4 dynamic diagram: a lecture room fills (room A1519, minute 10:07).
shape: sequence_diagram

(* -> *)[*].style.font-size: 20

occ: occupancysim {style.font-size: 21}
bs: BuildSim {style.font-size: 21}
phys: physics {style.font-size: 21}
clock: "clock\ndevice" {style.font-size: 21}
sensor: "CO₂ sensor\nand counter,\nroom A1519" {style.font-size: 21}
ctl: controller {style.font-size: 21}
damper: "damper,\nA1519" {style.font-size: 21}

occ -> bs: "1. minute 10:07:\n53 people in\nA1519 (clock\nrecord)"
phys -> bs: "2. reads the\nrecord and the\ndamper's state"
phys -> bs: "3. writes true\nCO₂ and head-\ncount, then the\ntime 10:07"
clock -> bs: "4. reads the time"
clock -> sensor: "5. time/model\n10:07 (MQTT)"
sensor -> bs: "6. each reads its own value"
sensor -> ctl: "7. obs: CO₂\nreading and 53\ncounted, each\nwith its noise\n(MQTT)"
ctl -> ctl: "8. predictive:\nmax(flow for\nCO₂, flow for\n53 people)"
ctl -> damper: "9. command\n408 l/s,\nTTL 300 s\n(REST)"
damper -> ctl: "10. 202\naccepted"
damper -> bs: "11. reached state, +10 % of maximum per minute"
phys -> bs: "12. next minute:\nreads the new\nairflow; CO₂\nrises more\nslowly"
