shape: sequence_diagram
occ: occupancysim
bs: BuildSim
phys: physics
clock: clock device
sensor: "CO₂ sensor and\ncounter, room A1519"
ctl: controller
damper: "damper, A1519"

occ -> bs: "1. minute 10:07: 53 people in A1519 (clock record)"
phys -> bs: "2. reads the record and the damper's state"
phys -> bs: "3. writes true CO₂ and head-count, then the time 10:07"
clock -> bs: "4. reads the time"
clock -> sensor: "5. time/model 10:07 (MQTT)"
sensor -> bs: "6. each reads its own value"
sensor -> ctl: "7. obs: CO₂ reading and 53 counted, each with its noise (MQTT)"
ctl -> ctl: "8. predictive: max(flow for CO₂, flow for 53 people)"
ctl -> damper: "9. command 408 l/s, TTL 300 s (REST)"
damper -> ctl: "10. 202 accepted"
damper -> bs: "11. reached state, +10 % of maximum per minute"
phys -> bs: "12. next minute: reads the new airflow; CO₂ rises more slowly"
