vars: { d2-config: { layout-engine: elk } }
direction: right
start: "" { shape: circle; width: 18; height: 18; style.fill: black }
waiting: "Uncommissioned\nnot in the registry:\ndoes nothing"
fallback: "Fallback\nno valid command:\ndesign flow"
following: "Following\ntravels to the commanded\nflow, floor enforced"
override: "Override\nCO₂ reading > 1100 ppm:\nmaximum flow"
freerun: "Own clock\n(time signal lost)\nkeeps time itself"

start -> waiting
waiting -> fallback: "installer registers it"
fallback -> following: "command accepted"
following -> fallback: "TTL expired\n(300 model-s)"
following -> override: "CO₂ > 1100"
fallback -> override: "CO₂ > 1100"
override -> following: "CO₂ ≤ 1100"
following -> freerun: "no beat for 5 s"
freerun -> fallback: "TTL expired on\nits own clock"
freerun -> following: "beat returns"
