# C4 Level 2, view 1 of 2: the control loop and the data path.
# One box is one compose service (the two device boxes are 150 and 100
# containers). Arrows point the way the data flows; a two-way arrow says
# which way each part goes.
# The registry and the dashboard are in container-support.d2: every link in one
# picture is too dense to print.
vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

(** -> **)[*].style.font-size: 19
(** <-> **)[*].style.font-size: 19

classes: {
  container: {
    style: {fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 20}
  }
  truth: {
    style: {fill: "#2A6F97"; stroke: "#1F5271"; font-color: "#ffffff"; font-size: 20}
  }
  store: {
    shape: cylinder
    style: {fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 20}
  }
  external: {
    style: {fill: "#8C8C8C"; stroke: "#6E6E6E"; font-color: "#ffffff"; font-size: 20}
  }
}

occ: "occupancysim\n[External: course example, modified]\nPeople and the model clock" {class: external}
bs: "BuildSim\n[External: provided by the course]\nShared building state" {class: external}

sys: "Ventilation Control [System]" {
  style: {stroke-dash: 4; fill: transparent; font-size: 22}

  physics: "physics\n[Container: Go]\nThe truth: CO₂ and heat\nbalance per room" {class: truth}
  sensors: "Sensor devices, 3 per room\nco2-, temp-, occ-NNNN\n[One container each: Go]\nSample, add noise and faults" {class: container}
  broker: "mosquitto\n[Container: MQTT broker]" {
    shape: queue
    style: {fill: "#438DD5"; stroke: "#2E6295"; font-color: "#ffffff"; font-size: 20}
  }
  controller: "controller\n[Container: Go]\nValidate, predict, decide" {class: container}
  actuators: "Actuator devices, 2 per room\ndamper-, heat-NNNN\n[One container each: Go]\nValidate, enforce safety, travel" {class: container}
  storage: "storage\n[Container: Go, JSONL files]\nEvery record, per run;\nhistory and models" {class: store}
  train: "train\n[Batch container: Go]\nBuilds the occupancy profile" {class: container}
}

occ -> sys.physics: "clock, people per\nminute [REST]"
bs -> sys.physics: "reached actuator\nstates [REST]"
sys.physics -> sys.sensors: "truth per room [REST]"
sys.physics -> sys.broker: "truth/#, time/model\n[MQTT]"
sys.sensors -> bs: "readings [REST]"
sys.sensors -> sys.broker: "obs/# [MQTT]"

sys.broker <-> sys.controller: "obs/# in,\ndecision/# out [MQTT]"
bs -> sys.controller: "readings, if the broker\nis silent [REST]" {style.stroke-dash: 3}
sys.controller -> sys.actuators: "commands [REST]"
sys.broker <-> sys.actuators: "CO₂ obs and time in,\nevent/# out [MQTT]"
sys.actuators -> bs: "reached state [REST]"

sys.broker -> sys.storage: "obs, truth, decision,\nevent [MQTT]"
sys.storage -> sys.controller: "model; the oracle's\nrecorded run [REST]"
sys.storage <-> sys.train: "history out,\nmodel back [REST]"
