vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

bs: "BuildSim\n[Software System, from course]\nShared state: sensor values,\nactuator state, 3D viewer"
occ: "occupancysim\n[Software System, course example]\nPeople and the model clock" {
  style.stroke-dash: 4
}
installer: "Installer\n[Person]\nMounts and registers devices" {
  shape: person
}

sys: "Ventilation Control  [System]" {
  style.stroke-dash: 4
  style.fill: transparent

  physics: "physics\n[Container: Go]\nCO₂ and heat balance per room;\nserves the truth, relays model time"
  registry: "registry\n[Container: Go + SQLite]\nInstalled devices, rooms, sizing" {
    shape: cylinder
  }
  sensors: "Sensor devices ×3 per room\nco2-NNNN · temp-NNNN · occ-NNNN\n[One container each: Go]\nSample truth, add noise and faults"
  broker: "mosquitto\n[MQTT broker]\nobs · truth · decision · event · time" {
    shape: queue
  }
  controller: "controller\n[Container: Go]\nValidate → predict → act"
  actuators: "Actuator devices ×2 per room\ndamper-NNNN · heat-NNNN\n[One container each: Go]\nValidate, enforce safety, travel"
  storage: "storage\n[Container: Go]\nJSONL per run; history + models" {
    shape: cylinder
  }
  train: "train\n[Batch job: Go]\nPer-room occupancy profile"
  viz: "viz\n[Container: Go]\nThe only room-layer publisher"
}

installer -> sys.registry: "Registers id, kind, room [REST / web form]"
occ -> bs: "Occupancy, entities [REST]"
occ -> sys.physics: "Model clock [REST]"
bs -> sys.physics: "Occupancy, actuator state [REST]"
sys.sensors -> sys.registry: "Check in, learn room [REST]"
sys.actuators -> sys.registry: "Check in, advertise address [REST]"
sys.controller -> sys.registry: "Rooms, actuator addresses [REST]"
sys.registry -> bs: "Equipment records [REST]"
sys.sensors -> sys.physics: "Truth per room [REST]"
sys.sensors -> bs: "Readings [REST]"
sys.sensors -> sys.broker: "obs/# [MQTT]"
sys.physics -> sys.broker: "truth/# [MQTT]"
sys.broker -> sys.controller: "obs/# [MQTT]"
sys.controller -> sys.broker: "decision/# [MQTT]"
sys.controller -> sys.actuators: "Commands [REST]"
sys.broker -> sys.actuators: "CO₂ for the override, model time [MQTT]"
sys.actuators -> bs: "Reached state [REST]"
sys.broker -> sys.storage: "obs, truth, decisions [MQTT]"
sys.storage -> sys.controller: "Latest model [REST]"
sys.train <-> sys.storage: "History in, model out [REST]"
sys.broker -> sys.viz: "obs, decisions [MQTT]"
sys.viz -> bs: "Room layers, alerts [REST]"
