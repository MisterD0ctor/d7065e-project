# C4 Level 1: system context.
vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

*.style.font-size: 22
(* -> *)[*].style.font-size: 20

manager: Facility Manager {
  shape: person
  label.near: outside-top-center
}
installer: Installer {
  shape: person
  label.near: outside-top-center
}
control: Ventilation Control
buildsim: BuildSim {
  style.stroke-dash: 4
}
occupancysim: occupancysim {
  style.stroke-dash: 4
}
physics: "Physical model\n(ours)" {
  style.stroke-dash: 4
}

manager -> control: monitors
installer -> control: "registers\ndevices"
control -> buildsim: "observes and acts through\nits sensor and actuator devices"
occupancysim -> buildsim: "publishes people and\nthe model clock"
physics -> buildsim: "writes the true sensor values,\nreads the actuators' states"
