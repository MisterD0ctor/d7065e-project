vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

manager: Facility Manager {
  shape: person
}
installer: Installer {
  shape: person
}
control: Ventilation Control
buildsim: BuildSim {
  style.stroke-dash: 4
}
occupancysim: occupancysim {
  style.stroke-dash: 4
}
physics: "Physical model\n(ours)" {
  style.stroke-dash: 4
}

manager -> control: monitors
installer -> control: registers devices
control -> buildsim: observes and acts through its sensor and actuator devices
occupancysim -> buildsim: publishes people and the model clock
physics -> buildsim: writes the true sensor values, reads the actuators' states
