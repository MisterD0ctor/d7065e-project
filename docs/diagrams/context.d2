# C4 Level 1: system context. Arrows point the way the data flows; a two-way
# arrow says which way each part goes.
vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

(** -> **)[*].style.font-size: 19
(** <-> **)[*].style.font-size: 19

classes: {
  person: {
    shape: person
    style: {fill: "#08427B"; stroke: "#073B6F"; font-size: 20}
  }
  system: {
    style: {fill: "#1168BD"; stroke: "#0B4884"; font-color: "#ffffff"; font-size: 20}
  }
  external: {
    style: {fill: "#8C8C8C"; stroke: "#6E6E6E"; font-color: "#ffffff"; font-size: 20}
  }
}

installer: "Installer\n[Person]" {
  class: person
  label.near: outside-top-center
}
occupancysim: "occupancysim\n[Software system: course\nexample, modified]\nSimulated people and\nthe model clock" {class: external}

control: "Ventilation Control\n[Software system, ours]\nSimulates the rooms' air, senses it,\ndecides airflow and heating\nper room, and shows it" {class: system}

buildsim: "BuildSim\n[Software system: provided\nby the course]\nShared building state:\nfloor plan, equipment, sensor\nvalues, actuator states;\n3D viewer" {class: external}
manager: "Facility manager\n[Person]" {class: person}

installer -> control: "registers each device:\nid, kind, room\n[web form, REST]"
occupancysim -> control: "model clock, people\nper room and minute,\nroom capacities [REST]"
occupancysim -> buildsim: "people, for the\nviewer [REST]"
control <-> buildsim: "out: equipment, readings, reached\nactuator states, room layers, alerts;\nin: floor plan, actuator states [REST]"
control -> manager: "graphs over time,\nalerts [web page]"
buildsim -> manager: "3D view with our layers\nand alerts [web viewer]"
