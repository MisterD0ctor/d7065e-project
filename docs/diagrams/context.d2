vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

manager: Facility Manager {
  shape: person
}
control: Ventilation Control
buildsim: BuildSim {
  style.stroke-dash: 4
}
occupancysim: occupancysim {
  style.stroke-dash: 4
}

manager -> control: monitors
control -> buildsim: observes and controls through device services
occupancysim -> buildsim: publishes people and occupancy
occupancysim -> control: model clock
